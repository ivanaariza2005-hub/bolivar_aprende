# Copia este archivo como .env y ajusta los valores.
NODE_ENV=development
PORT=3000

# SQLite: la ruta es relativa al directorio prisma del esquema.
DATABASE_URL="file:./dev.db"

# Obligatorio, mínimo 32 caracteres. Genera uno propio en producción.
JWT_SECRET="cambia-este-secreto-antes-de-produccion-0123456789abcdef"
JWT_EXPIRES_IN=7d

# Orígenes permitidos separados por coma. Usa * solo en desarrollo.
CORS_ORIGINS=*

# Niveles: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
