# Copia este archivo como .env y ajusta los valores.
NODE_ENV=development
PORT=3000

# PostgreSQL en Supabase (proyecto ymtfgdybmyquqjpsncqc, region us-east-1).
# Usa el Session pooler: funciona sobre IPv4. La conexion directa
# db.<ref>.supabase.co solo resuelve IPv6 y falla en redes sin IPv6.
# Si la contrasena tiene caracteres especiales, codificalos (%40 para @, etc).
# En produccion agrega &connection_limit=5&pool_timeout=20 para no agotar las
# conexiones del pooler de Supabase.
DATABASE_URL="postgresql://postgres.ymtfgdybmyquqjpsncqc:CAMBIA-ESTA-CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=20"

# Opcional. URL base para las pruebas: si se omite se usa DATABASE_URL con
# ?schema=test, de modo que los datos de prueba quedan aislados en el esquema
# "test" y no tocan "public".
# TEST_DATABASE_URL=""

# Obligatorio, minimo 32 caracteres. Genera uno propio en produccion.
JWT_SECRET="cambia-este-secreto-antes-de-produccion-0123456789abcdef"
JWT_EXPIRES_IN=7d

# Origenes permitidos separados por coma. Usa * solo en desarrollo.
CORS_ORIGINS=*

# Niveles: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
